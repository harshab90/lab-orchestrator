# Generated by orchestrator/configgen.py — copied as-is to every
# node's /etc/frr/daemons. Only zebra (RIB/FIB manager) and bgpd are
# needed for the bgp-lu design; enable isisd/ospfd here if a future
# topology needs them.
zebra=yes
bgpd=yes
ospfd=no
ospf6d=no
ripd=no
ripngd=no
isisd=no
pimd=no
ldpd=no
nhrpd=no
eigrpd=no
babeld=no
sharpd=no
pbrd=no
bfdd=no
fabricd=no
vrrpd=no
pathd=no

vtysh_enable=yes
zebra_options="  -A 127.0.0.1 -s 90000000"
bgpd_options="   -A 127.0.0.1"
