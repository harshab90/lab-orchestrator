! Generated by orchestrator/configgen.py — do not hand-edit, edit the
! topology YAML and regenerate instead.
hostname {{ node.name }}
!
interface Loopback0
   ip address {{ node.loopback0 }}
!
{% for prefix in node.customer_prefixes %}
interface Loopback{{ loop.index }}
   ip address {{ prefix }}
!
{% endfor %}
{% for peer_name, ifnum in node.interfaces.items() %}
interface Ethernet{{ ifnum }}
   no switchport
   ip address {{ link_ip(node.name, peer_name) }}
!
{% endfor %}
{% for pc in node.port_channels %}
{% for m in pc.members %}
interface Ethernet{{ m }}
   no switchport
   channel-group {{ pc.id }} mode active
!
{% endfor %}
interface Port-Channel{{ pc.id }}
   no switchport
   ip address {{ pc.ip }}
!
{% endfor %}
router isis CORE
   net {{ node.isis_net }}
   is-type level-2
   segment-routing mpls
      router-id {{ node.loopback0.split('/')[0] }}
      prefix-segment {{ node.loopback0 }} index {{ node.isis_sid_index }}
!
interface Loopback0
   isis enable CORE
   isis passive
!
{% for peer_name, ifnum in node.interfaces.items() %}
interface Ethernet{{ ifnum }}
   isis enable CORE
   isis network point-to-point
!
{% endfor %}
{% for pc in node.port_channels %}
interface Port-Channel{{ pc.id }}
   isis enable CORE
   isis network point-to-point
!
{% endfor %}
router bgp {{ node.bgp_as }}
   router-id {{ node.loopback0.split('/')[0] }}
   neighbor PE-MESH peer-group
   neighbor PE-MESH remote-as {{ node.bgp_as }}
   neighbor PE-MESH update-source Loopback0
   neighbor PE-MESH next-hop-self
   {% for peer in edge_peers %}
   neighbor {{ peer.loopback0.split('/')[0] }} peer-group PE-MESH
   {% endfor %}
   !
   address-family ipv4
      neighbor PE-MESH activate
      {% for prefix in node.customer_prefixes %}
      network {{ prefix }}
      {% endfor %}
!
end
