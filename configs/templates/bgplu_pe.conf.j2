! Generated by orchestrator/configgen.py — do not hand-edit.
! Single flat BGP mesh — no IS-IS, no separate overlay. Since every
! site belongs to one company (no per-customer VPN separation
! needed), loopbacks AND customer prefixes are both advertised
! directly into the same direct-link sessions, in the same
! address-family ipv4 labeled-unicast. Dallas/Singapore (Route
! Reflectors) relay everything end-to-end — there is no second,
! loopback-based overlay session set.
hostname {{ node.name }}
!
interface Loopback0
   ip address {{ node.loopback0 }}
!
{% for prefix in node.customer_prefixes %}
interface Loopback{{ loop.index }}
   ip address {{ prefix }}
!
{% endfor %}
{% for peer_name, ifnum in node.interfaces.items() %}
interface Ethernet{{ ifnum }}
   no switchport
   ip address {{ link_ip(node.name, peer_name) }}
!
{% endfor %}
{% for pc in node.port_channels %}
{% for m in pc.members %}
interface Ethernet{{ m }}
   no switchport
   channel-group {{ pc.id }} mode active
!
{% endfor %}
interface Port-Channel{{ pc.id }}
   no switchport
   ip address {{ pc.ip }}
!
{% endfor %}
router bgp {{ node.bgp_as }}
   router-id {{ node.loopback0.split('/')[0] }}
   maximum-paths 4 ecmp 4
   !
   {% for nb in node.underlay_neighbors %}
   neighbor {{ nb.peer_ip }} remote-as {{ node.bgp_as }}
   neighbor {{ nb.peer_ip }} next-hop-self
   {% endfor %}
   !
   address-family ipv4 labeled-unicast
      {% for nb in node.underlay_neighbors %}
      neighbor {{ nb.peer_ip }} activate
      {% endfor %}
      network {{ node.loopback0 }}
      {% for prefix in node.customer_prefixes %}
      network {{ prefix }}
      {% endfor %}
!
end
