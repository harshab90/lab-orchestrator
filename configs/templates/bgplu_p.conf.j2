! Generated by orchestrator/configgen.py — do not hand-edit.
! Pure BGP-LU transit + Route Reflector (RFC 8277) — no IS-IS, no
! customer routes, no overlay session. Reflects labeled routes
! between its clients; sessions to other RRs (e.g. the Dallas-
! Singapore link) stay plain peer sessions, not client sessions —
! standard route-reflection rules propagate correctly either way.
hostname {{ node.name }}
!
interface Loopback0
   ip address {{ node.loopback0 }}
!
{% for peer_name, ifnum in node.interfaces.items() %}
interface Ethernet{{ ifnum }}
   no switchport
   ip address {{ link_ip(node.name, peer_name) }}
!
{% endfor %}
{% for pc in node.port_channels %}
{% for m in pc.members %}
interface Ethernet{{ m }}
   no switchport
   channel-group {{ pc.id }} mode active
!
{% endfor %}
interface Port-Channel{{ pc.id }}
   no switchport
   ip address {{ pc.ip }}
!
{% endfor %}
router bgp {{ node.bgp_as }}
   router-id {{ node.loopback0.split('/')[0] }}
   maximum-paths 4 ecmp 4
   !
   {% for nb in node.underlay_neighbors %}
   neighbor {{ nb.peer_ip }} remote-as {{ node.bgp_as }}
   neighbor {{ nb.peer_ip }} next-hop-self
   {% if nb.is_client %}
   neighbor {{ nb.peer_ip }} route-reflector-client
   {% endif %}
   {% endfor %}
   !
   address-family ipv4 labeled-unicast
      {% for nb in node.underlay_neighbors %}
      neighbor {{ nb.peer_ip }} activate
      {% endfor %}
      network {{ node.loopback0 }}
!
end
